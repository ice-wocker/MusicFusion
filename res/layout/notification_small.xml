<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nsmall_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#0d1117">

    <ImageView
        android:id="@+id/nsmall_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher"
        android:contentDescription="@string/notif_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nsmall_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MusicFusion"
            android:textSize="14sp"
            android:textColor="#e6edf3"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/nsmall_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="艺术家"
            android:textSize="11sp"
            android:textColor="#8b949e"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/nsmall_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pause"
            android:contentDescription="@string/notif_pause" />

        <ImageButton
            android:id="@+id/nsmall_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_next"
            android:contentDescription="@string/notif_next" />
    </LinearLayout>
</LinearLayout>